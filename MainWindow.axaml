<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="GenealogyDiffUtility.MainWindow"
        Title="Genealogy Diff Utility"
        Width="1000" Height="600"
        MinWidth="640" MinHeight="400">

  <Grid RowDefinitions="Auto,*">

    <!-- Top control panel spanning the full window width -->
    <Border Grid.Row="0"
            Padding="8"
            BorderBrush="#22000000"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,*,Auto"
            ColumnSpacing="8"
            VerticalAlignment="Center">
        <TextBlock Text="Left File:"
                   VerticalAlignment="Center" />
        <TextBox x:Name="LeftFileTextBox"
                 Grid.Column="1"
                 PlaceholderText="Select the left file..." />
        <Button Grid.Column="2"
                Content="&#8230;"
                Width="36"
                Click="OnBrowseLeftClick"
                ToolTip.Tip="Browse for the left file" />
        <TextBlock Grid.Column="3"
                   Text="Right File:"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0" />
        <TextBox x:Name="RightFileTextBox"
                 Grid.Column="4"
                 PlaceholderText="Select the right file..." />
        <Button Grid.Column="5"
                Content="&#8230;"
                Width="36"
                Click="OnBrowseRightClick"
                ToolTip.Tip="Browse for the right file" />
      </Grid>
    </Border>

    <!-- Main area split in two for the diff view -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*">
      <Border Padding="8"
              BorderBrush="#22000000"
              BorderThickness="0,0,1,0">
        <ScrollViewer>
          <TextBlock x:Name="LeftContentTextBlock"
                     Text="Left file contents will appear here..."
                     TextWrapping="Wrap" />
        </ScrollViewer>
      </Border>
      <Border Grid.Column="1"
              Padding="8"
              BorderBrush="#22000000"
              BorderThickness="1,0,0,0">
        <ScrollViewer>
          <TextBlock x:Name="RightContentTextBlock"
                     Text="Right file contents will appear here..."
                     TextWrapping="Wrap" />
        </ScrollViewer>
      </Border>
    </Grid>

  </Grid>
</Window>